{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .agents/skills/refresh-repo-knowledge/scripts/copilot.mjs",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .agents/skills/refresh-repo-knowledge/scripts/copilot.mjs",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .agents/skills/refresh-repo-knowledge/scripts/copilot.mjs",
        "cwd": ".",
        "matcher": "Edit|Write",
        "timeoutSec": 5
      }
    ]
  }
}
